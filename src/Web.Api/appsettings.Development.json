{
  "ConnectionStrings": {
    "Database": "Server=(localdb)\\MSSQLLocalDB;Database=EkasiProperty;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Seq"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "Seq",
        "Args": { "ServerUrl": "http://seq:5341" }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "Jwt": {
    "Secret": "super-duper-secret-value-that-should-be-in-user-secrets",
    "Issuer": "clean-architecture",
    "Audience": "developers",
    "ExpirationInMinutes": 60,
    "RequireHttpsMetadata": false
  },
  "Cors": {
    "Origins": [ "http://localhost:5173", "http://localhost:4173" ]
  },
  "Cookies": {
    "Secure": false
  },
  "AzureBlobStorage": {
    // Azurite, the Azure Storage emulator. Start it with `docker compose up azurite`
    // (or `azurite-blob` from the npm package); the well-known devstoreaccount1 credentials
    // are baked into this shortcut, so there is no secret here.
    "ConnectionString": "UseDevelopmentStorage=true"
  }
}
